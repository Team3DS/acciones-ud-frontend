# Claves de la cuenta PAPER de Alpaca. Nunca usar el prefijo VITE_.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# iex: cobertura limitada incluida en el plan gratuito. sip requiere permisos.
ALPACA_DATA_FEED=iex

# Opcional: respaldo de cotización (último precio), no ejecución de órdenes.
FINNHUB_API_KEY=

# Puerto del servidor de la compilación de producción local.
PORT=3001

# Vite reenvía /api/v1 al gateway durante desarrollo y preview.
API_PROXY_TARGET=http://127.0.0.1:8080

# Para un frontend publicado en un origen distinto al gateway:
# VITE_API_BASE_URL=https://gateway.ejemplo.edu/api/v1

# Opcional. Ruta WebSocket STOMP expuesta por el gateway.
# Para el endpoint SockJS de M4 se utiliza el transporte nativo /websocket.
# VITE_QUOTES_WS_URL=/api/v1/market/ws/quotes/websocket

# M1 de main (8ece707) recibe celular. M1 del contrato 1.1 recibe telefono.
# VITE_IDENTITY_CONTRACT=main

# Habilita exclusivamente el prototipo local anterior.
# VITE_DEMO_MODE=true
